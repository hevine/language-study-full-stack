# ---- 服务配置 ----
NODE_ENV=development
PORT=4399
# 监听地址。默认 127.0.0.1：只有本机能访问，同局域网的手机/同事打不开你的页面与额度。
# 只有明确需要「手机也能看」时才改成 0.0.0.0，并清楚风险。
HOST=127.0.0.1
# 本地数据目录（SQLite 数据库存放处）
DATA_DIR=./.data
LOG_LEVEL=info

# ---- 大模型 Key 池（可选，界面里也能配）----
# 不填则进入「演示模式」：使用内置考纲模板库生成每日材料。
# 日常更推荐在「设置 → 模型 Key 池」里添加，支持多平台多 Key 自动切换。
# 下面这三项填了以后，会作为「环境变量线路」排在号池队尾，且不写进数据库。
# 示例（智谱）：  LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4.7-flash
# 示例（混元）：  LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1  LLM_MODEL=hunyuan-lite
# 示例（魔搭）：  LLM_BASE_URL=https://api-inference.modelscope.cn/v1  LLM_MODEL=Qwen/Qwen3-8B-Instruct
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=90000

# ---- 密钥加密主密钥（可选，但很推荐）----
# 界面里保存的 Key 会用 AES-256-GCM 加密后才写进 SQLite。
# 主密钥优先级：本环境变量 > .data/.llmkey（首次保存时自动生成，权限 600）。
# 放在环境变量里意味着「连磁盘都不落」，代价是换机器要自己带着它，否则旧密文解不开。
# 生成方法：openssl rand -base64 32
# LLM_MASTER_KEY=

# ---- 用户与鉴权 ----
# false（默认）：保留单机游客模式，不登录仍以 local 身份使用现有数据。
# true：除登录相关端点外，所有 /api 接口都需要有效令牌。
AUTH_REQUIRED=false
# 访问令牌只存浏览器内存（15 分钟）；刷新令牌在 HttpOnly Cookie 里（30 天，每次使用轮换）
AUTH_ACCESS_TTL_SEC=900
AUTH_REFRESH_TTL_SEC=2592000
# 令牌签名密钥。留空则首次启动自动生成 .data/.authkey（权限 600，不入库）。
# 生成方法：openssl rand -base64 48
# AUTH_JWT_SECRET=
AUTH_ISSUER=waiyu-baodian
# 扫码回调的公网基址，必须是微信开放平台 / 钉钉后台登记的 HTTPS 域名。
# 本地默认 http://127.0.0.1:4399，仅供未启用扫码时使用。
# AUTH_PUBLIC_BASE_URL=https://your-domain.example.com
# CSRF 同源白名单补充项：逗号分隔的完整 origin，用于自定义域名 / 局域网 IP 访问。
# 开发态已自动放行 localhost / 127.0.0.1 / ::1 的任意端口（Vite 端口被占用会自动顺延），
# 生产态只认白名单 + AUTH_PUBLIC_BASE_URL，第三方站点一律拒绝。
# AUTH_ALLOWED_ORIGINS=https://app.example.com,http://192.168.1.20:5199
# 首次启动给本地管理员（用户名 admin）设置密码；之后请改用：
#   NEW_ADMIN_PASSWORD='新密码' npm run admin:passwd
# AUTH_ADMIN_PASSWORD=
# 是否开放自助注册（默认开启）：false 时只能由管理员手工建号
AUTH_ALLOW_REGISTER=true
# 新用户（注册/扫码）的初始状态：active 直接可用；pending 需管理员审核后才能登录
AUTH_NEW_USER_STATUS=active
# 账号级失败锁定：连续 N 次密码错误后锁定 M 分钟（N=0 关闭锁定）
AUTH_LOCK_THRESHOLD=5
AUTH_LOCK_MINUTES=15
# 二维码票据有效期 / 回调确认后允许的兑换窗口（秒）
AUTH_TICKET_TTL_SEC=300
AUTH_LOGIN_CODE_TTL_SEC=90
# 留空则跟随 NODE_ENV：生产自动开启 Secure Cookie
# AUTH_COOKIE_SECURE=false
# 登录、刷新、二维码相关接口的固定窗口限流（每个 IP）
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SEC=60

# ---- 微信开放平台：网站应用扫码登录（QRConnect）----
# 需已认证开发者资质 + 审核通过的「网站应用」，回调域名要与后台登记一致。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 留空则自动使用 ${AUTH_PUBLIC_BASE_URL}/api/auth/callback/wechat
# WECHAT_REDIRECT_URI=
# 官方流程：
#   授权 https://open.weixin.qq.com/connect/qrconnect   (scope=snsapi_login)
#   换票 https://api.weixin.qq.com/sns/oauth2/access_token
#   资料 https://api.weixin.qq.com/sns/userinfo

# ---- 钉钉开放平台：统一授权登录第三方网站（OAuth2 新版）----
# 企业内部应用填 AppKey/AppSecret；需在「钉钉登录与分享」登记回调域名，
# 并申请「通讯录个人信息读权限」，否则 /v1.0/contact/users/me 拿不到 unionId。
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_SCOPE=openid
# 留空则自动使用 ${AUTH_PUBLIC_BASE_URL}/api/auth/callback/dingtalk
# DINGTALK_REDIRECT_URI=
# 官方流程：
#   授权 https://login.dingtalk.com/oauth2/auth   (scope=openid, prompt=consent)
#   换票 POST https://api.dingtalk.com/v1.0/oauth2/userAccessToken
#   资料 GET  https://api.dingtalk.com/v1.0/contact/users/me  (x-acs-dingtalk-access-token)

